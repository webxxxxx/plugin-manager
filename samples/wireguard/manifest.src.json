{
  "schema": 1,
  "name": "wireguard",
  "version": "1.0.0",
  "desc": "WireGuard tunnel manager (sample package)",
  "platform": "x86_64-unknown-linux-musl",
  "protocol": 1,
  "exec": {
    "path": "payload/bin/wg-agent",
    "args": ["--stdio"],
    "ready": "notify"
  },
  "dependencies": [],
  "capabilities": [
    {
      "name": "status",
      "desc": "Show tunnel and peer status",
      "inputSchema": {"type": "object", "properties": {}, "additionalProperties": false}
    },
    {
      "name": "up",
      "desc": "Bring the tunnel up with an interface config",
      "inputSchema": {"type": "object", "properties": {"config": {"type": "string"}}, "required": ["config"], "additionalProperties": false}
    },
    {
      "name": "down",
      "desc": "Bring the tunnel down",
      "inputSchema": {"type": "object", "properties": {}, "additionalProperties": false}
    }
  ],
  "ui": {"type": "web", "entry": "index.html"},
  "hooks": {"postInstall": "hooks/post-install.sh", "preRemove": "hooks/pre-remove.sh"}
}
