#!/usr/bin/env python3
"""WireGuard plugin sample agent.

Speaks the svcd control protocol (NDJSON JSON-RPC 2.0, one message per line):
  svcd.ping                 -> {"ok": true}          (readiness probe)
  svcd.status               -> {"summary": ...}      (optional status capability)
  svcd.shutdown             -> exit 0                (polite stop notification)
  tools/call {name,arguments}-> MCP-shaped result    (capability call)

This is a sample: it does not touch the kernel or a real WireGuard interface.
"""
import json
import sys

STATE = {"up": False, "listen": 51820, "peers": 0}


def log(msg):
    print("wg-agent: " + str(msg), file=sys.stderr, flush=True)


def reply(rid, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": rid}
    if error is not None:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg, separators=(",", ":"), ensure_ascii=False) + "\n")
    sys.stdout.flush()


def status_text():
    if STATE["up"]:
        return "tunnel up, listen :" + str(STATE["listen"]) + ", peers " + str(STATE["peers"])
    return "tunnel down"


def call_tool(rid, name, args):
    if name == "status":
        reply(rid, {"content": [{"type": "text", "text": status_text()}], "isError": False})
    elif name == "up":
        cfg = args.get("config")
        if not isinstance(cfg, str) or not cfg.strip():
            reply(rid, {"content": [{"type": "text", "text": "up: missing config"}], "isError": True})
            return
        STATE["up"] = True
        STATE["peers"] = cfg.count("[Peer]")
        reply(rid, {"content": [{"type": "text", "text": "tunnel up: " + status_text()}], "isError": False})
    elif name == "down":
        STATE["up"] = False
        reply(rid, {"content": [{"type": "text", "text": "tunnel down"}], "isError": False})
    else:
        reply(rid, error={"code": -32602, "message": "unknown tool: " + str(name)})


def main():
    log("started")
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except json.JSONDecodeError:
            reply(None, error={"code": -32700, "message": "parse error"})
            continue
        method = req.get("method")
        rid = req.get("id")
        params = req.get("params") or {}
        if method == "svcd.ping":
            reply(rid, {"ok": True})
        elif method == "svcd.status":
            reply(rid, {"summary": status_text(), "details": {"listen": STATE["listen"], "peers": STATE["peers"]}})
        elif method == "svcd.shutdown":
            log("shutdown requested")
            return 0
        elif method == "tools/call":
            call_tool(rid, params.get("name"), params.get("arguments") or {})
        elif rid is None:
            continue
        else:
            reply(rid, error={"code": -32601, "message": "method not found: " + str(method)})
    return 0


if __name__ == "__main__":
    sys.exit(main())
