# svcd runtime configuration example.
#
# Copy this file to the svcd program directory as `svcd.conf`, or pass it to
# `svcd --install --conf <file>` / `svcd run --foreground --conf <file>`.
# The service startup order is:
#   1. the path passed at install/startup (`--conf`)
#   2. `<program dir>/svcd.conf`
#   3. `<config dir>/svcd.conf` (legacy)
#   4. a generated default with platform paths
#
# Lines are `key = value`; lines starting with `#` are comments.
# Every key can be overridden by `SVCD_<KEY>` in the environment, with the key
# upper-cased (for example `SVCD_MAX_STREAMS`, `SVCD_ALLOW_INSECURE_INSTALL`).
# The environment wins over this file; an empty variable means "not set".
# Unknown `SVCD_*` variables (test hooks, `SVCD_USER`, ...) are not config keys.
# Non-root processes default to user mode (config under ~/.config/svcd on
# Linux); this example is primarily for the root/system service.
# Relative `config_dir` / `data_dir` / `logs_dir` values resolve against the
# directory containing this file.

# HTTP listener. The default is loopback-only. A non-loopback bind (for
# example 0.0.0.0:8787) requires auth_passwd; without it svcd falls back to
# 127.0.0.1 so you can still run `svc lan passwd` and restart.
bind = 127.0.0.1:8787

# Unsigned plugin installs. Default false: an unsigned package is rejected as a
# signature failure. Set this to true only on a host whose operator accepts
# unsigned packages; installs then verify normally first and fall back to
# accepting an unsigned package. There is no per-install flag or console option.
# allow_insecure_install = false

# The three roots. Everything else derives from them:
#   config_dir -> svcd.conf, services.d/, trust.d/, compat.conf
#   data_dir   -> plugins/, temp/, run/ (control socket and http.port)
#   logs_dir   -> svcd.log, <id>.log, <id>-hooks.log, stats.log
# Defaults: /etc/svcd (Linux config), /Library/Application Support/svcd/config
# (macOS), %ProgramData%\svcd\config (Windows system mode), and the matching
# platform data/log directories.
# config_dir = /etc/svcd
# data_dir = /var/lib/svcd
# logs_dir = /var/log/svcd
#
# Removed keys and variables are ignored with a warning that names the derived
# path: plugins_dir, services_dir, temp_dir, SVCD_TEMP_DIR, SVCD_RUN_DIR,
# SVCD_TRUST_DIR. Every live key instead has an SVCD_<KEY> override (see the
# top of this file); the removed names are not aliases for them.

# Installation root, recorded by `svcd --install --prefix <dir>` and also
# honored when written by hand: reinstalls without `--prefix` and
# `--uninstall` use it. It is only an install prefix: at configuration
# initialization it supplies <install_dir>/config, <install_dir>/data and
# <install_dir>/logs when those roots are absent, then the roots above are
# written into this file. An explicit config_dir/data_dir/logs_dir still wins,
# and runtime never derives paths from install_dir. `--prefix` still wins over
# it. On read-only-rootfs hosts (for example SR6110) install with
# `svcd --install --manual` to skip init registration and generate
# `svcd_daemon.sh` (Unix) or `svcd_daemon.bat` (Windows).
# Changing the recorded root does not move an existing materialized root; edit
# that root to move it.
# install_dir = /etc/sr/svcd

# Web/API password hash. Never put the plaintext here; set it with:
#   svc lan passwd <password>
# auth_passwd = pbkdf2-sha256$10000$...

# Transient plugin data (blob arguments/results) lives in <data>/temp. It is
# derived, not configured; upload staging and status hooks use the same tree.
# Files older than temp_retention_secs are deleted; 0 disables the cleanup
# thread entirely. Defaults: retention 7200s (2h), scan every 300s.
# temp_retention_secs = 7200
# temp_cleanup_interval_secs = 300

# Supervisor loop cadence, in milliseconds. `rescan_interval_ms` compares the
# services.d fingerprint and reconciles (0 = never rescan; `svc reload` still
# works). The daemon scans services.d once at boot without waiting; a late mount
# is picked up by the rescan. Default: 5000. The legacy
# `SVCD_RESCAN_INTERVAL_MS` env var still overrides it at startup.
# rescan_interval_ms = 5000

# Logs. `logs_dir` is one of the three roots above; the platform default is
# used only when the file does not name it.
# `log_max_bytes` is the rotation threshold for one file; `log_rotations` is
# how many old files are kept. `log_to_file = off` keeps stderr/syslog only.
# `log_level` is the minimum level written anywhere: error, warn, info (the
# default), debug or trace. A lower level is dropped before it reaches a file.
# `log = off` is the master switch: no log file and no stderr at all.
#
# ---------------------------------------------------------------------------
# Memory budget, workload shape and derived limits (#161)
# ---------------------------------------------------------------------------
#
# The resource keys below are not a table of defaults any more. On every start
# svcd reads this machine (free memory, the cgroup v2 limit of the container,
# CPU count) and derives one **memory budget**: the peak memory this process may
# plan for. `MEM_LEVEL=low|middle|high` (build time) is the ceiling that budget
# can never exceed: 128 MiB / 512 MiB / 8 GiB. It only tightens.
#
#   mem_budget_bytes = auto      # default; 25% of free memory, capped by the build
#   mem_budget_bytes = 268435456 # a number is taken as written (only the build cap lowers it)
#   mem_budget_percent = 50      # the same decision as a share of free memory,
#                                # 1..100; resolved at every start and then
#                                # treated exactly like a number. Mutually
#                                # exclusive with mem_budget_bytes.
#
# The **workload shape** decides how the budget is spent, not how big it is:
#
#   tiny         a small device with a handful of clients
#   interactive  a general-purpose host with a few browser sessions  (default
#                below 2 GiB of budget)
#   streaming    many long-lived streams and large in-flight payloads
#
#   workload = tiny | interactive | streaming   # default: derived from the budget
#
# The **CPU budget** is a live policy, not a reservation. 0 (the default) means
# no cap. Above 0 svcd installs the platform's hard cap when it can (a cgroup
# v2 cpu.max on Linux, a job object CPU rate on Windows) and always refuses new
# connections once its own measured CPU use stays above the target; existing
# requests finish. Note that 90% is not "90% of capacity": queueing delay at 90%
# utilization is roughly nine times the idle latency, so 70-80% is the calmer
# choice.
#
#   cpu_budget_percent = 0    # default; 0..100, 0 disables the governor
#   cpu_budget_percent = 80   # shed new connections above 80% of this machine
#
# The default is only a suggestion: `svc config tune` prints (or writes) the
# configuration it recommends for this machine, one key per line with the
# derivation in the trailing comment. `svc status --resources` shows what the
# last start actually ran with, including every rewritten value.
#
# Each key gets its value from `[absolute floor, min(share x budget, absolute
# ceiling)]`. Inside that band an explicit value is taken as written. The
# connection count is the exception: an unconfigured one is solved from what the
# rest of the worst case leaves over (one slot costs the resident body plus the
# stream buffer, tens of kilobytes rather than megabytes); an explicit one is
# used as written and then shrunk by the invariant. Above the
# band it falls back to the shape's reference value (not to the ceiling); below
# the floor it is raised. Every rewrite is logged at startup as
#
#   override: max_connections: 4096 -> 682 (above-upper-bound)
#
# and kept in `svc status --resources` until the next start. The worst case is
# also checked against the budget:
#
#   baseline + threads x stack + connections x (resident body + stream buffer)
#     + streams x stream buffer + in-flight raw bytes + queued frames x frame
#
# When it does not fit, the resident body shrinks first, then the concurrency
# (floor 8); a configuration that still cannot fit refuses to start with the
# offending terms in the message. It never runs until the OOM killer decides.
#
# The historical three-level table is now the **expected value at the shape's
# reference budget** (tiny at 128 MiB, interactive at 512 MiB, streaming at
# 2 GiB); it is a calibration anchor, not a runtime constant:
#   key                          tiny@128MiB  interactive@512MiB  streaming@2GiB
#   max_body_bytes               8388608      67108864            536870912
#   max_json_body_bytes          65536        262144              1048576
#   max_complete_body_bytes      65536        1048576             2097152
#   max_connections              solved from the budget, not tabulated here
#   max_connections_per_ip       same as max_connections unless set
#   max_streams                  24           48                  96
#   blocking_threads             4            8                   16
#   blocking_queue               min(max_connections, 256)
#   stream_buffer_bytes          8192         32768               131072
#   ws_inflight_bytes            2097152      8388608             67108864
#   ws_inflight_requests         4            16                  128
#   ws_raw_queue                 8            32                  128
#   pending_queue                32           128                 512
#   progress_queue               16           64                  256
#   request_stack_bytes          131072       196608              262144
#   io_stack_bytes               65536        98304               131072
#   http_idle_timeout_secs       30           60                  120
#   max_package_bytes            8388608      67108864            536870912
#
# Keys that cannot cost memory (timeouts, thread stacks, log sizes, package
# size) keep their shape value instead of scaling with RAM.
#
# Every probe input can be stated instead of read. A stated item wins and the
# matching OS read is skipped, which is how a container whose /proc lies — or a
# reproduction of a user's machine — states its resources without an
# environment override. `0` means "unknown" and does not fall back to a probe.
#
#   probe_available_memory      free memory, in bytes (also suppresses the total)
#   probe_cgroup_remaining      what the memory cgroup still allows, in bytes
#   probe_cpus                  online CPUs
#   probe_install_free_disk     free space on the installation volume, in bytes
#   probe_temp_free_disk        free space on the temporary volume, in bytes
#
# A trailing `# comment` is allowed after a value when the hash is preceded by
# whitespace, which is what `svc config tune` writes.
#
# The blocking pool runs face handlers that cannot run on the server loop
# (control-channel round trips and disk work). It starts a fixed number of
# worker threads and never spawns a temporary one. A full queue or a second job
# on one connection answers 503 busy with Retry-After.
# `blocking_threads` defaults to 2 and is clamped to 2..8. The default
# topology is four daemon threads on both hosts: the supervisor loop (which
# also polls plugin stdio), the server loop and these two workers. Raising the
# value is an operator choice, not a regression. Requires a daemon restart.
#
# control_timeout_secs bounds one management route's control-channel round
# trip. A supervisor that does not answer within it releases the blocking
# worker and the connection with HTTP 504 timeout; 503 remains only the
# blocking-queue-full signal. Defaults to 30 and is clamped to 1..300.
# Requires a daemon restart.
#
# A connection is a wait-set entry, not a thread, on both hosts: the invariant
# charges a stack for the loops and the blocking workers, never for one
# connection, so max_connections costs memory but not threads.
#
# max_streams caps long-lived and transfer streams: SSE, WebSocket, raw
# WebSocket, MCP SSE, blob/file upload and download, export, import and install.
# One-shot static assets served for a plugin UI page are exempt, so a page with
# more assets than max_streams still loads. stream_buffer_bytes bounds one
# handler's output buffer; a slow reader stops input at that high-water mark
# instead of growing memory.
#
# The upper bound of max_streams is the connection ceiling (4096): one plugin
# UI panel holds one WebSocket, so a stream cap below the connection count
# would make most of a large connection budget unreachable for the workload
# that needs it most. Set it lower only when streams really should be scarce.
#
# `ws_raw_*` control the protocol-3 raw transport
# (`/plugin-ui/{id}/{token}/raw`): a plugin that declares `protocol: 3`
# exchanges length-framed binary payloads on stdin/stdout.
#   ws_raw_max_bytes        cap for one frame, in bytes
#   ws_inflight_bytes       unacknowledged raw bytes across all plugins
#   ws_inflight_requests    unacknowledged raw frames across all plugins
#   ws_raw_queue            frames queued for one plugin's stdin
# The supervisor loop polls the raw pipes on both hosts (Unix poll(2), Windows
# IOCP), so a raw plugin adds no threads; a slow plugin fills its queue instead
# of blocking a thread. Raise the in-flight limits when the workload
# legitimately has many large frames in flight. A plugin that did not declare
# protocol 3 answers 503 raw_unavailable.
#
# `pending_queue` bounds the management requests queued between the server loop
# and the supervisor loop; `progress_queue` bounds the progress events queued
# between the reactor and one MCP stream. Both are derived from the budget; a
# full queue is a visible busy error, never memory growth.
#
# A farm of plugin UI panels is the one shape the derivation handles poorly: the
# single-request body grows with the budget and is charged per connection, so
# the slots pay for a body a UI stream never sends. Pin the body and let the
# budget go to slots instead:
#
#   mem_budget_percent = 90
#   workload = tiny
#   max_complete_body_bytes = 65536
#
# On a 5 GiB host that solves the connection ceiling (4096) instead of 1024-ish;
# the real limit then becomes the plugin processes themselves (a shell plugin
# costs ~3.4 MiB of RAM, so ~1500 fit in 5 GiB). See
# docs/perf/2026-11-21-ws-plugin-capacity.md.
#
# Explicit values below override the derivation. Changing any of them requires a
# daemon restart; `svc config tune --write` maintains them as one block.
# logs_dir = /var/log/svcd
# log_max_bytes = 65536
# log_rotations = 3
# log_to_file = on
# log_level = info
# log = on
# mem_budget_bytes = auto
# workload = interactive
# cpu_budget_percent = 0
# probe_available_memory = 8589934592
# probe_cgroup_remaining = 1073741824
# probe_cpus = 4
# probe_install_free_disk = 10737418240
# probe_temp_free_disk = 5368709120
# request_stack_bytes = 196608
# io_stack_bytes = 98304
# blocking_threads = 8
# blocking_queue = 256
# max_body_bytes = 67108864
# max_json_body_bytes = 262144
# max_complete_body_bytes = 1048576
# max_header_bytes = 16384
# max_streams = 16
# stream_buffer_bytes = 32768
# max_connections = 128
# max_connections_per_ip = 32
# max_subscriptions = 16
# max_subscribers_per_plugin = 16
# http_idle_timeout_secs = 60
# max_package_bytes = 67108864
# transfer_timeout_secs = 120
# control_timeout_secs = 30
# Call timeout in milliseconds: default_timeout is the per-call budget,
# max_timeout is the hard ceiling the kernel clamps to. These are the call
# budget of the invocation envelope, not the memory budget.
# default_timeout = 30000
# max_timeout = 300000
# ws_max_message_bytes = 1048576
# ws_inflight_bytes = 8388608
# ws_inflight_requests = 16
# ws_buffer_shrink_bytes = 65536
# ws_raw_enabled = on
# mcp_streaming = off   # on: an MCP client that accepts both JSON and SSE gets
#                       # a stream. off (default): it gets one JSON body, which
#                       # skips a stream slot and a reactor hop. A client that
#                       # only accepts text/event-stream always streams.
# ws_raw_max_bytes = 1048576
# ws_raw_queue = 32
# pending_queue = 128
# progress_queue = 64

# Absolute paths (the generated default uses the platform locations):
# Linux:
# plugins_dir = /var/lib/svcd/plugins
# services_dir = /etc/svcd/services.d
# macOS:
# plugins_dir = /Library/Application Support/svcd/plugins
# services_dir = /Library/Application Support/svcd/config/services.d
# Windows:
# plugins_dir = C:\ProgramData\svcd\plugins
# services_dir = C:\Users\<user>\.svcd\services.d
