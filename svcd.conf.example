# svcd runtime configuration example.
#
# Copy this file to the svcd program directory as `svcd.conf`, or pass it to
# `svcd --install --conf <file>` / `svcd run --foreground --conf <file>`.
# The service startup order is:
#   1. the path passed at install/startup (`--conf`)
#   2. `<program dir>/svcd.conf`
#   3. `<config dir>/svcd.conf` (legacy)
#   4. a generated default with platform paths
#
# Lines are `key = value`; lines starting with `#` are comments.
# Relative `config_dir` / `plugins_dir` / `services_dir` values resolve against
# the directory containing this file.

http_port = 8787
lan_default = false

# Configuration directory: svcd.conf, trust.d, lan.json and svcd.token.
# Defaults: /etc/svcd (Linux), /Library/Application Support/svcd/config
# (macOS), %USERPROFILE%\.svcd (Windows).
# config_dir = /etc/svcd

# Installation root for hosts whose writable tree is limited (for example
# SR6110, where only /etc/ persists). When set, `svcd --install` puts the
# binary, the svc/plugin/mcp aliases and a generated `svcd_daemon.sh` launcher
# there; data and logs default to <install_dir>/data and <install_dir>/logs.
# `--prefix` on the command line still wins. Service registration is skipped:
# add the printed `::respawn:<install_dir>/svcd_daemon.sh` line to the firmware
# /etc/inittab instead. Leave unset to keep the platform defaults.
# install_dir = /etc/sr/svcd

# Web/API password hash. Never put the plaintext here; set it with:
#   svc auth passwd <password>
# auth_passwd = pbkdf2-sha256$10000$...

# Absolute paths (the generated default uses the platform locations):
# Linux:
# plugins_dir = /var/lib/svcd/plugins
# services_dir = /etc/svcd/services.d
# macOS:
# plugins_dir = /Library/Application Support/svcd/plugins
# services_dir = /Library/Application Support/svcd/config/services.d
# Windows:
# plugins_dir = C:\ProgramData\svcd\plugins
# services_dir = C:\Users\<user>\.svcd\services.d
