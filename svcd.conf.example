# svcd runtime configuration example.
#
# Copy this file to the svcd program directory as `svcd.conf`, or pass it to
# `svcd --install --conf <file>` / `svcd run --foreground --conf <file>`.
# The service startup order is:
#   1. the path passed at install/startup (`--conf`)
#   2. `<program dir>/svcd.conf`
#   3. `<config dir>/svcd.conf` (legacy)
#   4. a generated default with platform paths
#
# Lines are `key = value`; lines starting with `#` are comments.
# Non-root processes default to user mode (config under ~/.config/svcd on
# Linux); this example is primarily for the root/system service.
# Relative `config_dir` / `plugins_dir` / `services_dir` / `temp_dir` values
# resolve against the directory containing this file.

# HTTP listener. The default is loopback-only. A non-loopback bind (for
# example 0.0.0.0:8787) requires auth_passwd; without it svcd falls back to
# 127.0.0.1 so you can still run `svc auth passwd` and restart.
bind = 127.0.0.1:8787

# Unsigned plugin installs. Default false: an unsigned package is rejected as a
# signature failure. Set this to true only on a host whose operator accepts
# unsigned packages; installs then verify normally first and fall back to
# accepting an unsigned package. There is no per-install flag or console option.
# allow_insecure_install = false

# Configuration directory: svcd.conf, trust.d and svcd.token.
# Defaults: /etc/svcd (Linux), /Library/Application Support/svcd/config
# (macOS), %USERPROFILE%\.svcd (Windows).
# config_dir = /etc/svcd

# Installation root, recorded by `svcd --install --prefix <dir>` and also
# honored when written by hand: reinstalls without `--prefix`, the data/logs
# defaults (<install_dir>/data, <install_dir>/logs) and `--uninstall` all use
# it. `--prefix` still wins over it. On read-only-rootfs hosts (for example
# SR6110) install with `svcd --install --manual` to skip init registration and
# generate `svcd_daemon.sh` (Unix) or `svcd_daemon.bat` (Windows).
# Changing this value directly moves data/logs; it does not regenerate a
# launcher that was already written by `--manual`.
# install_dir = /etc/sr/svcd

# Web/API password hash. Never put the plaintext here; set it with:
#   svc auth passwd <password>
# auth_passwd = pbkdf2-sha256$10000$...

# Transient plugin data (blob arguments/results). Default: <data>/temp.
# Files older than temp_retention_secs are deleted; 0 disables the cleanup
# thread entirely. Defaults: retention 7200s (2h), scan every 300s.
# temp_dir = /var/tmp/svcd
# temp_retention_secs = 7200
# temp_cleanup_interval_secs = 300

# Logs. `logs_dir` defaults to install_dir/logs or the platform log directory.
# `log_max_bytes` is the rotation threshold for one file; `log_rotations` is
# how many old files are kept. `log_to_file = off` keeps stderr/syslog only.
#
# Compile-time MEM_LEVEL supplies the defaults (high is the default):
#   key                    low        middle      high
#   log_max_bytes          65536      65536       65536
#   log_rotations          3          3           3
#   request_stack_bytes    131072     196608      262144
#   io_stack_bytes         65536      98304       131072
#   max_body_bytes         8388608    67108864    536870912
#   max_json_body_bytes    65536      262144      1048576
#   max_complete_body_bytes 131072    1048576     8388608
#   max_header_bytes       8192       16384       65536
#   max_streams            8          16          64
#   stream_buffer_bytes    16384      32768       65536
#   max_connections        32         128         512
#   max_connections_per_ip 8          32          64
#   max_subscriptions      4          16          64
#   max_subscribers_per_plugin 4      16          64
#   http_idle_timeout_secs 30         60          120
#   max_package_bytes      8388608    67108864    536870912
#   transfer_timeout_secs  120        120         120
#   default_timeout        30000      30000       30000
#   max_timeout            300000     300000      300000
#   ws_max_message_bytes   1048576    1048576     1048576
#   ws_inflight_bytes      2097152    8388608     67108864
#   ws_inflight_requests   4          16          64
#   ws_buffer_shrink_bytes 65536      65536       65536
#   ws_raw_enabled         on         on          on
#   ws_raw_max_bytes       1048576    1048576     1048576
#   ws_raw_queue           16         64          128
#
# `ws_raw_*` control the protocol-3 raw transport
# (`/plugin-ui/{id}/{token}/raw`): a plugin that declares `protocol: 3`
# exchanges length-framed binary payloads on stdin/stdout.
#   ws_raw_max_bytes        cap for one frame, in bytes
#   ws_inflight_bytes       unacknowledged raw bytes across all plugins
#   ws_inflight_requests    unacknowledged raw frames across all plugins
#   ws_raw_queue            frames queued for one plugin's stdin
# On Unix the plugin-stdio reactor owns the raw pipes, so a raw plugin adds no
# threads; a slow plugin fills its queue instead of blocking a thread. Raise
# the in-flight limits when the workload legitimately has many large frames in
# flight. On Windows the route answers 501 not_supported.
#
# Explicit values below override the MEM_LEVEL defaults. They are clamped to a
# safe range; changing them requires a daemon restart.
# logs_dir = /var/log/svcd
# log_max_bytes = 65536
# log_rotations = 3
# log_to_file = on
# request_stack_bytes = 131072
# io_stack_bytes = 65536
# max_body_bytes = 8388608
# max_json_body_bytes = 65536
# max_complete_body_bytes = 131072
# max_header_bytes = 8192
# max_streams = 8
# stream_buffer_bytes = 16384
# max_connections = 32
# max_connections_per_ip = 8
# max_subscriptions = 4
# max_subscribers_per_plugin = 4
# http_idle_timeout_secs = 30
# max_package_bytes = 8388608
# transfer_timeout_secs = 120
# Call timeout in milliseconds: default_timeout is the per-call budget,
# max_timeout is the hard ceiling the kernel clamps to.
# default_timeout = 30000
# max_timeout = 300000
# ws_max_message_bytes = 1048576
# ws_inflight_bytes = 2097152
# ws_inflight_requests = 4
# ws_buffer_shrink_bytes = 65536
# ws_raw_enabled = on
# ws_raw_max_bytes = 1048576
# ws_raw_queue = 16

# Absolute paths (the generated default uses the platform locations):
# Linux:
# plugins_dir = /var/lib/svcd/plugins
# services_dir = /etc/svcd/services.d
# macOS:
# plugins_dir = /Library/Application Support/svcd/plugins
# services_dir = /Library/Application Support/svcd/config/services.d
# Windows:
# plugins_dir = C:\ProgramData\svcd\plugins
# services_dir = C:\Users\<user>\.svcd\services.d
